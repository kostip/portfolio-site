---
import { render } from 'astro:content';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';
import { getPublishedProjects } from '../../../utils/projects';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();

  return projects.map((project, index) => {
    const nextProject = projects[(index + 1) % projects.length] ?? project;

    return {
      params: { slug: project.id },
      props: { project, nextProject },
    };
  });
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
---

<ProjectLayout project={project} nextProject={nextProject}>
  <Content />
</ProjectLayout>
