---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  favicon?: string;
  robots?: string;
  bodyClass?: string;
  headerAutoHide?: boolean;
}

const {
  title,
  description = 'Портфолио продуктового дизайнера Константина Вершигоры.',
  favicon,
  robots,
  bodyClass,
  headerAutoHide = true,
} = Astro.props;

const faviconTypes: Record<string, string> = {
  ico: 'image/x-icon',
  png: 'image/png',
  svg: 'image/svg+xml',
  webp: 'image/webp',
};
const faviconPath = favicon?.trim();
const faviconExtension = faviconPath
  ?.match(/\.([a-z0-9]+)(?:[?#].*)?$/i)?.[1]
  ?.toLocaleLowerCase();
const faviconType = faviconExtension ? faviconTypes[faviconExtension] : undefined;
const localFaviconExists = faviconPath?.startsWith('/')
  ? existsSync(resolve(process.cwd(), 'public', faviconPath.split(/[?#]/)[0].replace(/^\/+/, '')))
  : true;
const projectFavicon = faviconPath && faviconType && localFaviconExists
  ? { href: faviconPath, type: faviconType }
  : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {
      projectFavicon ? (
        <link rel="icon" type={projectFavicon.type} href={projectFavicon.href} />
      ) : (
        <>
          <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
          <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
        </>
      )
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <Header autoHide={headerAutoHide} />
    <div id="main-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
