---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p>Константин Вершигора, {year}</p>
    <div class="footer-socials">
      <a
        href="mailto:versh.konstantin@gmail.com"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Написать Константину на почту"
      >
        <img src="/icons/email.svg" width="32" height="32" alt="" />
      </a>
      <a
        href="https://t.me/k0stip"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Написать Константину в Telegram"
      >
        <img src="/icons/tg.svg" width="32" height="32" alt="" />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-navigation-stroke);
  }

  .footer-inner {
    display: flex;
    width: min(calc(100% - 40px), var(--wide-width));
    margin-inline: auto;
    padding-block: 20px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-inner p {
    min-width: 0;
    margin: 0;
    color: rgb(36 40 51 / 40%);
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
  }

  .footer-socials {
    display: flex;
    min-width: 76px;
    flex: 0 0 auto;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    margin-left: auto;
  }

  .footer-socials a,
  .footer-socials img {
    display: block;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
  }

  @media (max-width: 839px) {
    .footer-inner {
      display: flex;
      width: 100%;
      padding: 20px;
      flex-direction: row;
      flex-wrap: nowrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      overflow: visible;
    }

    .footer-inner p {
      min-width: 0;
      flex: 1 1 auto;
      font-size: 14px;
    }

  }
</style>
