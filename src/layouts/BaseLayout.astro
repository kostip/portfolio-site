---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  disableCanonical?: boolean;
  disableSocialMeta?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  favicon?: string;
  bodyClass?: string;
  headerAutoHide?: boolean;
}

const {
  title,
  description = 'Портфолио продуктового дизайнера Константина Вершигоры.',
  socialImage,
  socialImageAlt,
  ogType = 'website',
  noindex = false,
  disableCanonical = false,
  disableSocialMeta = false,
  structuredData,
  favicon,
  bodyClass,
  headerAutoHide = true,
} = Astro.props;

const canonicalUrl = !disableCanonical && Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
const socialImageUrl = socialImage && Astro.site
  ? new URL(socialImage, Astro.site)
  : undefined;
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;

const faviconTypes: Record<string, string> = {
  ico: 'image/x-icon',
  png: 'image/png',
  svg: 'image/svg+xml',
  webp: 'image/webp',
};
const faviconPath = favicon?.trim();
const faviconExtension = faviconPath
  ?.match(/\.([a-z0-9]+)(?:[?#].*)?$/i)?.[1]
  ?.toLocaleLowerCase();
const faviconType = faviconExtension ? faviconTypes[faviconExtension] : undefined;
const localFaviconExists = faviconPath?.startsWith('/')
  ? existsSync(resolve(process.cwd(), 'public', faviconPath.split(/[?#]/)[0].replace(/^\/+/, '')))
  : true;
const projectFavicon = faviconPath && faviconType && localFaviconExists
  ? { href: faviconPath, type: faviconType }
  : undefined;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Константин Вершигора" />
    <meta name="theme-color" content="#ffffff" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {
      !disableSocialMeta && (
        <>
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content="Константин Вершигора" />
          <meta property="og:locale" content="ru_RU" />
          {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
          {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
          {socialImageUrl && socialImageAlt && (
            <meta property="og:image:alt" content={socialImageAlt} />
          )}
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
          {socialImageUrl && socialImageAlt && (
            <meta name="twitter:image:alt" content={socialImageAlt} />
          )}
        </>
      )
    }
    {
      projectFavicon ? (
        <link rel="icon" type={projectFavicon.type} href={projectFavicon.href} />
      ) : (
        <>
          <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
          <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
        </>
      )
    }
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    {serializedStructuredData && (
      <script type="application/ld+json" set:html={serializedStructuredData} />
    )}
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    <Header autoHide={headerAutoHide} />
    <div id="main-content">
      <slot />
    </div>
    <Footer />
  </body>
</html>
