---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import UiButton from '../components/UiButton.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.order !== undefined)
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const resumeUrl = 'https://novosibirsk.hh.ru/resume/2dada270ff06c0c99b0039ed1f474e644b6e41';
const contacts = [
  {
    label: 'Telegram',
    text: 't.me/k0stip',
    href: 'https://t.me/k0stip',
    icon: '/icons/tg.svg',
    kind: 'telegram',
    external: true,
  },
  {
    label: 'E-mail',
    text: 'versh.konstantin@gmail.com',
    href: 'mailto:versh.konstantin@gmail.com',
    icon: '/icons/email.svg',
    kind: 'email',
    external: false,
  },
  {
    label: 'HH.ru',
    text: 'Резюме на hh.ru',
    href: resumeUrl,
    icon: '/icons/hh.svg',
    kind: 'hh',
    external: true,
  },
] as const;
---

<BaseLayout
  title="Константин Вершигора — Product и UX/UI Designer"
  description="Product и UX/UI дизайнер с опытом проектирования B2B- и SaaS-продуктов, сложных интерфейсов и пользовательских сценариев."
>
  <main class="home-page">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <div class="hero__content">
          <div class="hero__copy">
            <h1 id="hero-title">
              <span class="hero__title-primary">Product — UX/UI Designer</span>
              <span class="hero__title-secondary">Проектирую B2B и SaaS со сложными сценариями</span>
            </h1>
            <p>
              7+ лет создаю понятные интерфейсы — от исследования и структуры до UI и передачи в разработку
            </p>
          </div>
          <UiButton
            class="hero__resume"
            href={resumeUrl}
            label="Резюме на hh.ru"
            target="_blank"
            rel="noopener noreferrer"
          />
        </div>

        <img
          class="hero__avatar"
          src="/images/common/avatar.webp"
          width="260"
          height="300"
          alt="Константин Вершигора"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <section id="projects" class="projects-section home-container" aria-labelledby="projects-title">
      <h2 id="projects-title">Мои проекты</h2>
      <div class="projects-list">
        {projects.map((project, index) => <ProjectCard project={project} eager={index === 0} />)}
      </div>
    </section>

    <section id="contacts" class="contacts-section home-container" aria-labelledby="contacts-title">
      <div class="contacts-section__heading">
        <h2 id="contacts-title">Мои контакты</h2>
        <img
          class="contacts-section__arrow"
          src="/icons/contact-arrow.svg"
          width="24"
          height="24"
          alt=""
          aria-hidden="true"
        />
      </div>

      <div class="contacts-list">
        {contacts.map((contact) => (
          <a
            class:list={['contact-link', `contact-link--${contact.kind}`]}
            href={contact.href}
            target={contact.external ? '_blank' : undefined}
            rel={contact.external ? 'noopener noreferrer' : undefined}
          >
            <span class="contact-link__label">
              <img src={contact.icon} width="22" height="22" alt="" aria-hidden="true" />
              <span>{contact.label}</span>
            </span>
            <span class="contact-link__value">{contact.text}</span>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .home-page {
    width: 100%;
  }

  .home-container {
    width: min(calc(100% - 40px), 840px);
    margin-inline: auto;
  }

  .hero {
    height: 400px;
    padding-block: 40px 60px;
    background: radial-gradient(circle at 50% 0%, #f3f5f6 0, #fff 68%);
  }

  .hero__inner {
    display: grid;
    width: min(calc(100% - 40px), 840px);
    height: 300px;
    margin-inline: auto;
    grid-template-columns: minmax(0, 540px) 260px;
    grid-template-rows: 300px;
    align-items: center;
    gap: 40px;
  }

  .hero__content {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    align-self: end;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .hero h1 {
    display: flex;
    margin: 0;
    flex-direction: column;
    font-size: 42px;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-wrap: pretty;
  }

  .hero__title-primary {
    color: #242833;
  }

  .hero__title-secondary {
    color: #939393;
  }

  .hero__copy p {
    max-width: 540px;
    margin: 0;
    color: rgb(36 40 51 / 60%);
    font-size: 16px;
    font-weight: 400;
    line-height: normal;
  }

  .hero__avatar {
    width: 260px;
    height: 300px;
    border-radius: 12px;
    object-fit: cover;
  }

  :global(.ui-button.hero__resume) {
    width: auto;
    height: auto;
    padding: 16px 24px;
    border-radius: 12px;
    font-size: 16px;
  }

  .projects-section {
    padding-top: 60px;
    scroll-margin-top: 94px;
  }

  .projects-section h2,
  .contacts-section h2 {
    margin: 0;
    font-size: 36px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .projects-list {
    display: flex;
    margin-top: 30px;
    flex-direction: column;
    gap: 80px;
  }

  .contacts-section {
    display: flex;
    min-height: 220px;
    margin-top: 120px;
    margin-bottom: 60px;
    padding: 30px;
    border-radius: 12px;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    background: #f4f3f6;
    scroll-margin-top: 94px;
  }

  .contacts-section__heading {
    display: flex;
    width: 100%;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }

  .contacts-section__arrow {
    width: 24px;
    height: 24px;
    flex: 0 0 24px;
  }

  .contacts-list {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr 1.75fr 1fr;
    align-items: start;
    gap: 28px;
  }

  .contact-link {
    display: flex;
    min-width: 0;
    margin: -8px;
    padding: 8px;
    border-radius: 8px;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    color: #242833;
    text-decoration: none;
    transition: background-color 160ms ease, opacity 160ms ease;
  }

  .contact-link:hover {
    background: rgb(255 255 255 / 55%);
  }

  .contact-link:focus-visible {
    outline: 3px solid rgb(36 40 51 / 35%);
    outline-offset: 2px;
  }

  .contact-link__label {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 8px;
    color: rgb(36 40 51 / 60%);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
  }

  .contact-link__label img {
    width: 22px;
    height: 22px;
    flex: 0 0 22px;
  }

  .contact-link__value {
    max-width: 100%;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: underline;
    text-underline-position: from-font;
    overflow-wrap: anywhere;
  }

  .contact-link--telegram .contact-link__value {
    color: #27a6e5;
  }

  .contact-link--email .contact-link__value {
    background: var(--gradient-email);
    background-clip: text;
    color: transparent;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .contact-link--hh .contact-link__value {
    color: #ff0002;
  }

  @media (max-width: 895px) {
    .hero {
      height: auto;
      padding-block: 30px;
    }

    .hero__inner {
      display: flex;
      height: auto;
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
      grid-template-rows: none;
    }

    .hero__avatar {
      order: -1;
      width: 200px;
      height: 200px;
    }

    .hero__content {
      width: 100%;
      gap: 24px;
      align-self: auto;
    }

    .hero__copy {
      width: 100%;
      gap: 16px;
    }

    .hero h1 {
      width: 100%;
      font-size: 26px;
      letter-spacing: -0.02em;
    }

    .hero__copy p {
      width: 100%;
    }

    .projects-section {
      padding-top: 40px;
      scroll-margin-top: 82px;
    }

    .projects-section h2,
    .contacts-section h2 {
      font-size: 28px;
    }

    .projects-list {
      gap: 60px;
    }

    .contacts-section {
      min-height: 0;
      margin-top: 80px;
      margin-bottom: 40px;
      padding: 20px;
      gap: 40px;
      scroll-margin-top: 82px;
    }

    .contacts-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 30px;
    }

    .contact-link {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>
