---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../../layouts/ProjectLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  const projectSequence = projects
    .filter((project) => project.data.order !== undefined)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

  return projects.map((project) => {
    const currentIndex = projectSequence.findIndex((item) => item.id === project.id);
    const nextProject = currentIndex >= 0
      ? projectSequence[(currentIndex + 1) % projectSequence.length]
      : projectSequence[0];

    return {
      params: { slug: project.id },
      props: { project, nextProject },
    };
  });
}

const { project, nextProject } = Astro.props;
const { Content } = await render(project);
---

<ProjectLayout project={project} nextProject={nextProject}>
  <Content />
</ProjectLayout>
