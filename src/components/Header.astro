---
import ContactDropdown from './ContactDropdown.astro';
import UiButton from './UiButton.astro';

interface Props {
  autoHide?: boolean;
}

const { autoHide = true } = Astro.props;
---

<header class="site-header" data-auto-hide={autoHide ? 'true' : 'false'}>
  <div class="header-inner">
    <a class="logo-author" href="/" aria-label="Константин Вершигора — на главную">
      <img
        class="logo-author__avatar"
        src="/images/common/avatar.webp"
        width="54"
        height="54"
        alt=""
      />
      <span class="logo-author__name">Константин Вершигора</span>
    </a>

    <nav class="header-navigation" aria-label="Основная навигация">
      <UiButton class="header-button header-button--projects" href="/#projects" label="Проекты" />
      <div class="contact-area">
        <UiButton
          class="header-button header-button--contact"
          label="Связаться"
          variant="gradient"
          aria-label="Открыть меню контактов"
          aria-expanded="false"
          aria-controls="contact-dropdown"
          data-contact-toggle
        />
        <ContactDropdown />
      </div>
    </nav>
  </div>
</header>

<script>
  const mobileQuery = window.matchMedia('(max-width: 839px)');
  const header = document.querySelector<HTMLElement>('.site-header');
  const showHeader = () => header?.classList.remove('is-hidden');

  document.querySelectorAll<HTMLElement>('.contact-area').forEach((area) => {
    const toggle = area.querySelector<HTMLButtonElement>('[data-contact-toggle]');
    if (!toggle) return;

    const setOpen = (open: boolean) => {
      area.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (open) showHeader();
    };

    const close = (force = false) => {
      setOpen(false);
      area.classList.toggle('is-force-closed', force);
    };

    toggle.addEventListener('click', () => {
      if (!mobileQuery.matches) return;
      area.classList.remove('is-force-closed');
      setOpen(!area.classList.contains('is-open'));
    });

    area.addEventListener('pointerenter', () => {
      if (mobileQuery.matches) return;
      area.classList.remove('is-force-closed');
      setOpen(true);
    });

    area.addEventListener('pointerleave', () => {
      if (mobileQuery.matches) return;
      close();
    });

    area.addEventListener('focusin', () => {
      if (mobileQuery.matches) return;
      area.classList.remove('is-force-closed');
      setOpen(true);
    });

    area.addEventListener('focusout', () => {
      if (mobileQuery.matches) return;
      requestAnimationFrame(() => {
        if (!area.contains(document.activeElement)) close();
      });
    });

    document.addEventListener('pointerdown', (event) => {
      if (mobileQuery.matches && !area.contains(event.target as Node)) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !area.classList.contains('is-open')) return;
      toggle.focus();
      close(!mobileQuery.matches);
    });

    area.querySelectorAll<HTMLAnchorElement>('.contact-dropdown__link').forEach((link) => {
      link.addEventListener('click', () => close());
    });

    mobileQuery.addEventListener('change', () => close());
  });

  if (header?.dataset.autoHide !== 'false' && !header.dataset.autoHideInitialized) {
    const movementThreshold = 10;
    const safeTopZone = 90;
    const safeBottomZone = 100;
    let previousScrollY = Math.max(0, window.scrollY);
    let accumulatedMovement = 0;
    let animationFrame: number | undefined;

    header.dataset.autoHideInitialized = 'true';

    const interactionKeepsHeaderVisible = () =>
      header.matches(':focus-within') || Boolean(header.querySelector('.contact-area.is-open'));

    const isNearPageBottom = (scrollY: number) =>
      window.innerHeight + scrollY >= document.documentElement.scrollHeight - safeBottomZone;

    const updateHeader = () => {
      const currentScrollY = Math.max(0, window.scrollY);
      const delta = currentScrollY - previousScrollY;
      previousScrollY = currentScrollY;

      if (document.documentElement.hasAttribute('data-lightbox-open')) {
        accumulatedMovement = 0;
        return;
      }

      if (
        currentScrollY <= safeTopZone ||
        isNearPageBottom(currentScrollY) ||
        interactionKeepsHeaderVisible()
      ) {
        accumulatedMovement = 0;
        showHeader();
        return;
      }

      if ((delta > 0 && accumulatedMovement < 0) || (delta < 0 && accumulatedMovement > 0)) {
        accumulatedMovement = 0;
      }

      accumulatedMovement += delta;
      if (Math.abs(accumulatedMovement) < movementThreshold) return;

      header.classList.toggle('is-hidden', accumulatedMovement > 0);
      accumulatedMovement = 0;
    };

    window.addEventListener('scroll', () => {
      if (animationFrame !== undefined) return;

      animationFrame = window.requestAnimationFrame(() => {
        updateHeader();
        animationFrame = undefined;
      });
    }, { passive: true });

    header.addEventListener('focusin', showHeader);
    window.addEventListener('portfolio:header-scroll-sync', (event) => {
      const hidden = (event as CustomEvent<{ hidden?: boolean }>).detail?.hidden;
      previousScrollY = Math.max(0, window.scrollY);
      accumulatedMovement = 0;
      if (typeof hidden === 'boolean') header.classList.toggle('is-hidden', hidden);
    });
    updateHeader();
  }
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 30;
    top: 0;
    height: 74px;
    border-bottom: 1px solid var(--color-navigation-stroke);
    background: var(--color-white);
    transform: translateY(0);
    transition: transform 250ms ease;
    will-change: transform;
  }

  .site-header.is-hidden {
    transform: translateY(calc(-100% - 2px));
  }

  .header-inner {
    display: flex;
    width: min(100%, 840px);
    height: 73px;
    margin-inline: auto;
    padding: 10px 0;
    align-items: center;
    justify-content: space-between;
  }

  .logo-author {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 12px;
    color: var(--color-black-text);
    text-decoration: none;
  }

  .logo-author__avatar {
    width: 54px;
    height: 54px;
    flex: 0 0 54px;
    border-radius: 12px;
    object-fit: cover;
  }

  .logo-author__name {
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
    white-space: nowrap;
  }

  .header-navigation {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .contact-area {
    position: relative;
  }

  .contact-area::after {
    position: absolute;
    top: 100%;
    right: 0;
    width: 100%;
    height: 10px;
    content: '';
  }

  :global(.ui-button.header-button) {
    height: 54px;
    padding-inline: 24px;
    border-radius: 12px;
    font-size: 16px;
  }

  :global(.header-button--projects) {
    width: 140px;
  }

  :global(.header-button--contact) {
    width: 160px;
  }

  :global(.contact-area .contact-dropdown) {
    top: calc(100% + 10px);
  }

  @media (max-width: 839px) {
    .site-header {
      height: 63px;
    }

    .header-inner {
      width: 100%;
      height: 62px;
      padding: 10px;
    }

    .logo-author {
      gap: 8px;
    }

    .logo-author__avatar {
      width: 42px;
      height: 42px;
      flex-basis: 42px;
      border-radius: 8px;
    }

    .logo-author__name {
      width: 82px;
      font-size: 13px;
      line-height: normal;
      white-space: normal;
    }

    .header-navigation {
      gap: 8px;
    }

    :global(.ui-button.header-button) {
      width: auto;
      height: 42px;
      padding-inline: 16px;
      border-radius: 8px;
      font-size: 13px;
    }
  }

  @media (max-width: 340px) {
    .site-header {
      height: 57px;
    }

    .header-inner {
      height: 56px;
    }

    .logo-author {
      gap: 6px;
    }

    .logo-author__avatar {
      width: 36px;
      height: 36px;
      flex-basis: 36px;
    }

    .logo-author__name {
      width: 62px;
      font-size: 11px;
      letter-spacing: -0.1px;
    }

    .header-navigation {
      gap: 6px;
    }

    :global(.ui-button.header-button) {
      height: 36px;
      padding-inline: 8px;
      font-size: 11px;
    }
  }

  @media (min-width: 341px) and (max-width: 380px) {
    .header-navigation {
      gap: 6px;
    }

    :global(.ui-button.header-button) {
      padding-inline: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }
  }
</style>
