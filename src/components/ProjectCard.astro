---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
---

<article class="project-card">
  <a class="card-link" href={`/projects/${project.id}/`}>
    {
      project.data.cover ? (
        <div class="card-visual card-visual--image">
          <img src={project.data.cover} alt={project.data.coverAlt ?? ''} loading="lazy" />
        </div>
      ) : (
        <div class="card-visual" aria-hidden="true">
          <span>Предпросмотр проекта</span>
        </div>
      )
    }
    <div class="card-copy">
      <div class="card-meta">
        <span>{project.data.role}</span>
        {project.data.year && <span>{project.data.year}</span>}
      </div>
      <h3>{project.data.title}</h3>
      <p>{project.data.description}</p>
      <span class="card-action">Открыть кейс <span aria-hidden="true">→</span></span>
    </div>
  </a>
</article>

<style>
  .project-card {
    border: 1px solid var(--color-line);
    background: var(--color-surface);
  }

  .card-link {
    display: block;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .card-visual {
    display: grid;
    min-height: clamp(15rem, 32vw, 23rem);
    place-items: center;
    border-bottom: 1px solid var(--color-line);
    background: var(--color-placeholder);
    color: var(--color-muted);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .card-visual--image {
    display: block;
    overflow: hidden;
  }

  .card-visual img {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
  }

  .card-copy {
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-muted);
    font-size: 0.85rem;
  }

  h3 {
    margin: 1rem 0 0.65rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .card-action {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .card-link:hover .card-action,
  .card-link:focus-visible .card-action {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
