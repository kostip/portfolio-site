---
import type { CollectionEntry } from 'astro:content';
import ImageLightbox from '../components/ImageLightbox.astro';
import ProjectNavigation from '../components/ProjectNavigation.astro';
import ProjectToc from '../components/ProjectToc.astro';
import UiButton from '../components/UiButton.astro';
import { getPublicImageDimensions } from '../utils/projectImages.mjs';
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  nextProject: CollectionEntry<'projects'>;
}

const { project, nextProject } = Astro.props;
const detailedMetadata = [
  { label: 'Роль', value: project.data.role },
  { label: 'Срок', value: project.data.duration },
  { label: 'Команда', value: project.data.team },
  { label: 'Продукт', value: project.data.product },
].filter((item) => item.value);

const metadata = detailedMetadata.length > 1
  ? detailedMetadata
  : [
      { label: 'Роль', value: project.data.role },
      { label: 'Год', value: project.data.year },
    ].filter((item) => item.value);
const titleIconIsImage = /^(?:\/|https?:\/\/|data:)/.test(project.data.titleIcon ?? '');
const titleIconFavicons: Record<string, string> = {
  '🎵': '/assets/tabs4me/favicon.svg',
};
const projectFavicon = titleIconIsImage
  ? project.data.titleIcon
  : titleIconFavicons[project.data.titleIcon ?? ''];
const coverDimensions = project.data.cover
  ? await getPublicImageDimensions(project.data.cover)
  : undefined;
const titleIconDimensions = titleIconIsImage && project.data.titleIcon?.startsWith('/')
  ? await getPublicImageDimensions(project.data.titleIcon)
  : undefined;
---

<BaseLayout
  title={`${project.data.title} — Константин Вершигора`}
  description={project.data.description}
  favicon={projectFavicon}
>
  <main class="project-page">
    <header class="project-header prose">
      <div class="project-back-navigation">
        <UiButton class="back-link" href="/" label="Все проекты" icon="left" />
      </div>
      <p class="eyebrow">Кейс{project.data.year && ` · ${project.data.year}`}</p>
      <div class="project-title">
        {
          project.data.titleIcon && titleIconIsImage && (
            <img
              class="project-title-icon"
              src={project.data.titleIcon}
              alt={project.data.titleIconAlt ?? ''}
              width={titleIconDimensions?.width ?? 48}
              height={titleIconDimensions?.height ?? 48}
            />
          )
        }
        {
          project.data.titleIcon && !titleIconIsImage && (
            <span
              class="project-title-icon project-title-icon--emoji"
              role="img"
              aria-label={project.data.titleIconAlt ?? ''}
            >
              {project.data.titleIcon}
            </span>
          )
        }
        <h1>{project.data.title}</h1>
      </div>
      <dl class:list={['project-metadata', { 'project-metadata--detailed': detailedMetadata.length > 1 }]}>
        {metadata.map((item) => (
          <div class="metadata-item">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    {
      project.data.cover ? (
        <div class="project-cover wide">
          <img
            src={project.data.cover}
            alt={project.data.coverAlt ?? ''}
            width={coverDimensions?.width}
            height={coverDimensions?.height}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      ) : (
        <div class="hero-placeholder wide" aria-label="Место для главного изображения проекта">
          <span>Главное изображение проекта</span>
        </div>
      )
    }

    <article class="article-content">
      <slot />
    </article>

    {project.data.order !== undefined && <ImageLightbox />}

    {project.data.order !== undefined && <ProjectToc />}

    <ProjectNavigation nextHref={`/projects/${nextProject.id}/`} />
  </main>
</BaseLayout>

<style>
  .project-page {
    padding-bottom: var(--space-8);
  }

  .project-header {
    padding-block: 0 40px;
  }

  .project-back-navigation {
    display: flex;
    height: 128px;
    align-items: center;
    justify-content: flex-start;
  }

  .project-title {
    position: relative;
    margin-top: var(--space-2);
  }

  .project-title-icon {
    --icon-gap: 20px;
    --icon-size: calc((var(--wide-width) - var(--prose-width)) / 2 - var(--icon-gap));
    position: absolute;
    top: 0;
    left: calc((var(--prose-width) - var(--wide-width)) / 2);
    width: var(--icon-size);
    height: var(--icon-size);
    object-fit: contain;
  }

  .project-title-icon--emoji {
    display: grid;
    place-items: center;
    font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    font-size: 48px;
    line-height: 1;
  }

  h1 {
    min-width: 0;
    margin: 0;
    overflow-wrap: anywhere;
    font-size: var(--font-h1);
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .project-metadata {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) 40px;
    margin: 40px 0 0;
  }

  .metadata-item {
    width: max-content;
    max-width: 100%;
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .project-metadata--detailed {
    width: 100%;
    max-width: 640px;
  }

  .project-metadata--detailed dt {
    font-size: 13px;
    line-height: 1.3;
  }

  .project-metadata--detailed dd {
    font-size: 14px;
    line-height: 1.4;
  }

  @media (min-width: 905px) {
    .project-metadata--detailed {
      display: grid;
      grid-template-columns:
        max-content
        max-content
        minmax(0, 1.7fr)
        minmax(0, 1fr);
      column-gap: 30px;
    }

    .project-metadata--detailed .metadata-item {
      width: auto;
      min-width: 0;
      white-space: normal;
    }
  }

  dt {
    margin-bottom: var(--space-1);
    color: var(--color-muted);
    font-size: var(--font-small);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  dd {
    margin: 0;
    font-size: var(--font-body);
    line-height: 1.4;
  }

  .hero-placeholder {
    display: grid;
    min-height: clamp(20rem, 58vw, 40rem);
    place-items: center;
    background: var(--color-placeholder);
    color: var(--color-muted);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .project-cover {
    overflow: hidden;
    border-radius: 18px;
    background: var(--color-surface);
  }

  .project-cover img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .article-content {
    padding-top: var(--space-4);
    background: var(--color-surface);
  }

  @media (max-width: 839px) {
    .project-back-navigation {
      height: 122px;
    }
  }

  @media (max-width: 904px) {
    .project-title {
      display: flex;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .project-title-icon {
      position: static;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      margin-top: 0.2rem;
    }

    .project-title-icon--emoji {
      font-size: 32px;
    }

    .project-metadata--detailed {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
      row-gap: 24px;
    }

    .project-metadata--detailed .metadata-item {
      width: auto;
      min-width: 0;
      white-space: normal;
    }
  }

  @media (max-width: 640px) {
    .project-header {
      padding-block: 0 32px;
    }

    .project-back-navigation {
      height: 96px;
    }

    .project-title {
      display: block;
      margin-top: 24px;
    }

    .project-title-icon {
      position: static;
      width: 36px;
      height: 36px;
      margin: 0 0 16px;
      object-fit: contain;
    }

    .project-title-icon--emoji {
      font-size: 28px;
    }

    .project-title h1 {
      width: 100%;
    }

    .project-metadata--detailed {
      row-gap: 24px;
      margin-top: 32px;
    }

    .project-metadata--detailed dt {
      font-size: 12px;
      line-height: 1.3;
    }

    .project-metadata--detailed dd {
      font-size: 13px;
      line-height: 1.4;
    }

    .project-cover {
      border-radius: 12px;
    }

    .article-content {
      padding-top: var(--space-3);
    }
  }
</style>
